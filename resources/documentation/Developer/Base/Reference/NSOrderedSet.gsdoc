          </desc>
        </method>
        <method type="instancetype" factory="yes" ovadd="10.7.0">
          <sel>orderedSetWithSet:</sel>
          <arg type="NSSet*">aSet</arg>
          <sel>copyItems:</sel>
          <arg type="BOOL">flag</arg>
          <desc>
            Create and return an ordered set with the elements
            in <var>aSet</var>. If <var>flag</var> is
            <code>YES</code>, copy the elements.
          </desc>
        </method>
        <method type="NSArray*" ovadd="10.7.0">
