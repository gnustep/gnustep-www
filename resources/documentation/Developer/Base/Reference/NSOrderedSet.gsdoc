    <chapter>
      <heading>
        Software documentation for the NSOrderedSet class
      </heading>
      <class name="NSOrderedSet" super="NSObject" ovadd="10.7.0">
        <declared>Foundation/NSOrderedSet.h</declared>
        <conform>NSCoding</conform>
        <conform>NSCopying</conform>
        <conform>NSMutableCopying</conform>
        <conform>NSFastEnumeration</conform>
        <desc>
          This class provides an ordered set, a set where the
          order of the elements matters and is preserved. Once
          created the set cannot be modified.
          NSMutableOrderedSet can be modified.
        </desc>
        <method type="instancetype" factory="yes" ovadd="10.7.0">
          <sel>orderedSet</sel>
          <desc>
            Create and return an empty ordered set.
          </desc>
        </method>
        <method type="instancetype" factory="yes" ovadd="10.7.0">
          <sel>orderedSetWithArray:</sel>
          <arg type="NSArray*">objects</arg>
          <desc>
            Create and return an empty ordered set with the
            provided NSArray instance.
          </desc>
        </method>
        <method type="instancetype" factory="yes" ovadd="10.7.0">
          <sel>orderedSetWithArray:</sel>
          <arg type="NSArray*">objects</arg>
          <sel>range:</sel>
          <arg type="NSRange">range</arg>
          <sel>copyItems:</sel>
          <arg type="BOOL">flag</arg>
          <desc>
            Create and return an empty ordered set with the
            provided NSArray instance. Use the
            <var>range</var> to determine which elements to use.
            If <var>flag</var> is <code>YES</code> copy the
            elements.
          </desc>
        </method>
        <method type="instancetype" factory="yes" ovadd="10.7.0">
          <sel>orderedSetWithObject:</sel>
          <arg type="id">anObject</arg>
          <desc>
            Create and return an ordered set with
            <var>anObject</var> as the sole member.
          </desc>
        </method>
        <method type="instancetype" factory="yes" ovadd="10.7.0">
          <sel>orderedSetWithObjects:</sel>
          <arg type="id">firstObject</arg>
          <vararg />
          <desc>
            Create and return an ordered set with list of
            arguments starting with <var>firstObject</var>
            and terminated with <code>nil</code>.
          </desc>
        </method>
        <method type="instancetype" factory="yes" ovadd="10.7.0">
          <sel>orderedSetWithObjects:</sel>
          <arg type="const id[]">objects</arg>
          <sel>count:</sel>
          <arg type="NSUInteger">count</arg>
          <desc>
            Create and return an ordered set using the C array
            of <var>objects</var> with <var>count</var>.
          </desc>
        </method>
        <method type="instancetype" factory="yes" ovadd="10.7.0">
          <sel>orderedSetWithOrderedSet:</sel>
