        <method type="NSArray*" factory="yes" ovadd="10.7.0">
          <sel>availableTagSchemesForLanguage:</sel>
          <arg type="NSString*">language</arg>
          <desc>
            Returns all available tag schemes for a specific
            <var>language</var>.
          </desc>
        </method>
        <method type="NSArray*" factory="yes" ovadd="10.7.0">
          <sel>availableTagSchemesForUnit:</sel>
          <arg type="NSLinguisticTaggerUnit">unit</arg>
          <sel>language:</sel>
          <arg type="NSString*">language</arg>
          <desc>
            Returns all available tag schemes for the specified
            <var>unit</var> and <var>language</var>.
          </desc>
        </method>
        <method type="NSString*" factory="yes" ovadd="10.7.0">
          <sel>dominantLanguageForString:</sel>
          <arg type="NSString*">string</arg>
          <desc>
            Returns the dominant language for a given
            <var>string</var>.
          </desc>
        </method>
        <method type="void" factory="yes" ovadd="10.7.0">
          <sel>enumerateTagsForString:</sel>
          <arg type="NSString*">string</arg>
          <sel>range:</sel>
          <arg type="NSRange">range</arg>
          <sel>unit:</sel>
          <arg type="NSLinguisticTaggerUnit">unit</arg>
          <sel>scheme:</sel>
          <arg type="NSLinguisticTagScheme">scheme</arg>
          <sel>options:</sel>
          <arg type="NSLinguisticTaggerOptions">options</arg>
          <sel>orthography:</sel>
          <arg type="NSOrthography*">orthography</arg>
          <sel>usingBlock:</sel>
          <arg type="GSLinguisticTagRangeBoolBlock">block</arg>
          <desc>
            Enumerates tags for a <var>string</var> over a
            <var>range</var> using a <var>block</var>.
          </desc>
        </method>
        <method type="NSLinguisticTag" factory="yes" ovadd="10.7.0">
          <sel>tagForString:</sel>
          <arg type="NSString*">string</arg>
          <sel>atIndex:</sel>
          <arg type="NSUInteger">charIndex</arg>
          <sel>unit:</sel>
          <arg type="NSLinguisticTaggerUnit">unit</arg>
          <sel>scheme:</sel>
          <arg type="NSLinguisticTagScheme">scheme</arg>
          <sel>orthography:</sel>
          <arg type="NSOrthography*">orthography</arg>
          <sel>tokenRange:</sel>
          <arg type="NSRangePointer">tokenRange</arg>
          <desc>
            Returns the tag for a character index in a
            <var>string</var>.
          </desc>
        </method>
        <method type="NSArray*" factory="yes" ovadd="10.7.0">
          <sel>tagsForString:</sel>
          <arg type="NSString*">string</arg>
          <sel>range:</sel>
          <arg type="NSRange">range</arg>
          <sel>unit:</sel>
          <arg type="NSLinguisticTaggerUnit">unit</arg>
          <sel>scheme:</sel>
          <arg type="NSLinguisticTagScheme">scheme</arg>
          <sel>options:</sel>
          <arg type="NSLinguisticTaggerOptions">options</arg>
          <sel>orthography:</sel>
          <arg type="NSOrthography*">orthography</arg>
          <sel>tokenRanges:</sel>
          <arg type="NSArray**">tokenRanges</arg>
          <desc>
            Returns tags for a <var>string</var> in a
            <var>range</var> with optional token ranges.
          </desc>
        </method>
        <method type="NSString*" ovadd="10.7.0">
          <sel>dominantLanguage</sel>
          <desc>
            Returns the dominant language of the text.
          </desc>
        </method>
        <method type="void" ovadd="10.7.0">
          <sel>enumerateTagsInRange:</sel>
          <arg type="NSRange">range</arg>
          <sel>scheme:</sel>
          <arg type="NSLinguisticTagScheme">tagScheme</arg>
          <sel>options:</sel>
          <arg type="NSLinguisticTaggerOptions">opts</arg>
          <sel>usingBlock:</sel>
          <arg type="GSLinguisticTagRangeRangeBoolBlock">block</arg>
          <desc>
            Enumerate over the tags in <var>range</var>,
            using <var>tagScheme</var>, with <var>opts</var>,
            execute <var>block</var> for each iteration.
          </desc>
        </method>
        <method type="void" ovadd="10.7.0">
          <sel>enumerateTagsInRange:</sel>
          <arg type="NSRange">range</arg>
          <sel>unit:</sel>
          <arg type="NSLinguisticTaggerUnit">unit</arg>
          <sel>scheme:</sel>
          <arg type="NSLinguisticTagScheme">scheme</arg>
          <sel>options:</sel>
          <arg type="NSLinguisticTaggerOptions">options</arg>
          <sel>usingBlock:</sel>
          <arg type="GSLinguisticTagRangeBoolBlock">block</arg>
          <desc>
            Enumerates tags over a <var>range</var> using a
            second <var>block</var> type (for finer control).
          </desc>
        </method>
        <method type="instancetype" ovadd="10.7.0">
          <sel>initWithTagSchemes:</sel>
          <arg type="NSArray*">tagSchemes</arg>
          <sel>options:</sel>
          <arg type="NSUInteger">opts</arg>
          <desc>
            Initializes a tagger with the given linguistic
            tag schemes and options.
          </desc>
        </method>
        <method type="NSOrthography*" ovadd="10.7.0">
          <sel>orthographyAtIndex:</sel>
          <arg type="NSUInteger">charIndex</arg>
          <sel>effectiveRange:</sel>
          <arg type="NSRangePointer">effectiveRange</arg>
          <desc>
            Returns the orthography at a specific character
            index and the effective range.
          </desc>
        </method>
        <method type="NSArray*" ovadd="10.7.0">
          <sel>possibleTagsAtIndex:</sel>
          <arg type="NSUInteger">charIndex</arg>
          <sel>scheme:</sel>
          <arg type="NSString*">tagScheme</arg>
          <sel>tokenRange:</sel>
          <arg type="NSRangePointer">tokenRange</arg>
          <sel>sentenceRange:</sel>
          <arg type="NSRangePointer">sentenceRange</arg>
          <sel>scores:</sel>
          <arg type="NSArray**">scores</arg>
          <desc>
            Returns the possible tags at a character index and
            their <var>scores</var>.
          </desc>
        </method>
        <method type="NSRange" ovadd="10.7.0">
          <sel>sentenceRangeForRange:</sel>
          <arg type="NSRange">range</arg>
          <desc>
            Returns the sentence <var>range</var> encompassing
            the given <var>range</var>.
          </desc>
        </method>
        <method type="void" ovadd="10.7.0">
          <sel>setOrthography:</sel>
          <arg type="NSOrthography*">orthography</arg>
          <sel>range:</sel>
          <arg type="NSRange">range</arg>
          <desc>
            Assigns a custom <var>orthography</var> object for
            the specified <var>range</var>.
          </desc>
        </method>
        <method type="void" ovadd="10.7.0">
          <sel>setString:</sel>
          <arg type="NSString*">string</arg>
          <desc>
            Sets the <var>string</var> to be tagged.
          </desc>
        </method>
        <method type="NSString*" ovadd="10.7.0">
          <sel>string</sel>
          <desc>
            Gets the string to be tagged.
          </desc>
        </method>
        <method type="void" ovadd="10.7.0">
          <sel>stringEditedInRange:</sel>
          <arg type="NSRange">newRange</arg>
          <sel>changeInLength:</sel>
          <arg type="NSInteger">delta</arg>
          <desc>
            Informs the tagger that a portion of the string has
            been edited.
          </desc>
        </method>
        <method type="NSLinguisticTag" ovadd="10.7.0">
          <sel>tagAtIndex:</sel>
          <arg type="NSUInteger">charIndex</arg>
          <sel>scheme:</sel>
          <arg type="NSLinguisticTagScheme">scheme</arg>
          <sel>tokenRange:</sel>
          <arg type="NSRangePointer">tokenRange</arg>
          <sel>sentenceRange:</sel>
          <arg type="NSRangePointer">sentenceRange</arg>
          <desc>
            return the NSLinguisticTag starting at
            <var>charIndex</var>, with the given
            <var>scheme</var> and within <var>tokenRange</var>,
            also return <var>sentenceRange</var>;
          </desc>
        </method>
        <method type="NSLinguisticTag" ovadd="10.7.0">
          <sel>tagAtIndex:</sel>
          <arg type="NSUInteger">charIndex</arg>
          <sel>unit:</sel>
          <arg type="NSLinguisticTaggerUnit">unit</arg>
          <sel>scheme:</sel>
          <arg type="NSLinguisticTagScheme">scheme</arg>
          <sel>tokenRange:</sel>
          <arg type="NSRangePointer">tokenRange</arg>
          <desc>
            Returns the tag at a character index and provides
            the token and sentence ranges.
          </desc>
        </method>
        <method type="NSArray*" ovadd="10.7.0">
          <sel>tagSchemes</sel>
          <desc>
            Returns the list of tag schemes used by this
            tagger.
          </desc>
        </method>
        <method type="NSArray*" ovadd="10.7.0">
          <sel>tagsInRange:</sel>
          <arg type="NSRange">range</arg>
          <sel>scheme:</sel>
          <arg type="NSString*">tagScheme</arg>
          <sel>options:</sel>
          <arg type="NSLinguisticTaggerOptions">opts</arg>
          <sel>tokenRanges:</sel>
          <arg type="NSArray**">tokenRanges</arg>
          <desc>
            Get the tags in the given <var>range</var>, for
            <var>tagScheme</var>, with <var>opts</var> return the
            ranges for those tags in <var>tokenRanges</var>.
          </desc>
        </method>
        <method type="NSArray*" ovadd="10.7.0">
          <sel>tagsInRange:</sel>
          <arg type="NSRange">range</arg>
          <sel>unit:</sel>
          <arg type="NSLinguisticTaggerUnit">unit</arg>
          <sel>scheme:</sel>
          <arg type="NSLinguisticTagScheme">scheme</arg>
          <sel>options:</sel>
          <arg type="NSLinguisticTaggerOptions">options</arg>
          <sel>tokenRanges:</sel>
          <arg type="NSArray**">tokenRanges</arg>
          <desc>
            Returns tags in a <var>range</var> for a given
            <var>scheme</var> with optional token ranges.
          </desc>
        </method>
        <method type="NSRange" ovadd="10.7.0">
          <sel>tokenRangeAtIndex:</sel>
          <arg type="NSUInteger">charIndex</arg>
          <sel>unit:</sel>
          <arg type="NSLinguisticTaggerUnit">unit</arg>
          <desc>
            Returns the token range at a given index for the
            specified <var>unit</var>.
          </desc>
        </method>
      </class>
    </chapter>
    <chapter>
      <heading>
        Software documentation for the
        NSString(NSLinguisticAnalysis)
        category
      </heading>
      <category name="NSLinguisticAnalysis" class="NSString" ovadd="10.7.0">
        <declared>Foundation/NSLinguisticTagger.h</declared>
        <desc>
          Category for NSString providing convenience
          linguistic analysis methods.
        </desc>
        <method type="void" ovadd="10.7.0">
          <sel>enumerateLinguisticTagsInRange:</sel>
          <arg type="NSRange">range</arg>
          <sel>scheme:</sel>
          <arg type="NSLinguisticTagScheme">scheme</arg>
          <sel>options:</sel>
          <arg type="NSLinguisticTaggerOptions">options</arg>
          <sel>orthography:</sel>
          <arg type="NSOrthography*">orthography</arg>
          <sel>usingBlock:</sel>
          <arg type="GSLinguisticTagRangeRangeBoolBlock">block</arg>
          <desc>
            Enumerates linguistic tags in a given
            <var>range</var>, passing each to the provided
            <var>block</var>. @param <var>range</var> Range to
            enumerate. @param <var>scheme</var> Tagging
            <var>scheme</var>. @param <var>options</var> Options
            for tagging. @param <var>orthography</var> Orthography
            reference. @param <var>block</var> Block to call
            with each result.
          </desc>
        </method>
        <method type="NSArray*" ovadd="10.7.0">
          <sel>linguisticTagsInRange:</sel>
          <arg type="NSRange">range</arg>
          <sel>scheme:</sel>
          <arg type="NSLinguisticTagScheme">scheme</arg>
          <sel>options:</sel>
          <arg type="NSLinguisticTaggerOptions">options</arg>
          <sel>orthography:</sel>
          <arg type="NSOrthography*">orthography</arg>
          <sel>tokenRanges:</sel>
          <arg type="NSArray**">tokenRanges</arg>
          <desc>
            Returns linguistic tags in the specified
            <var>range</var> using the given <var>scheme</var>
            and <var>orthography</var>. @param <var>range</var>
            Range of the string to analyze. @param
            <var>scheme</var> Tagging <var>scheme</var> to use.
            @param <var>options</var> Tagging <var>options</var>
            . @param <var>orthography</var> Orthography to guide
            analysis. @param <var>tokenRanges</var> Optional
            output for token ranges.
          </desc>
        </method>
      </category>
    </chapter>
  </body>
