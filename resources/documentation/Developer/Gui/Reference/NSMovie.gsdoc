  <body>
    <front><contents /></front>
    <chapter>
      <heading>
        Software documentation for the NSMovie class
      </heading>
      <class name="NSMovie" super="NSObject" ovadd="1.0.0">
        <declared>AppKit/NSMovie.h</declared>
        <conform>NSCopying</conform>
        <conform>NSCoding</conform>
        <desc>
          <em>Description forthcoming.</em>
        </desc>
        <method type="BOOL" factory="yes" ovadd="1.0.0">
          <sel>canInitWithPasteboard:</sel>
          <arg type="NSPasteboard*">pasteboard</arg>
          <desc>
            Returns <code>YES</code>, if the object can be
            initialized with the given
            <var>pasteboard</var>.
          </desc>
        </method>
        <method type="NSArray*" factory="yes" ovadd="1.0.0">
          <sel>movieUnfilteredFileTypes</sel>
          <desc>
            An array of all of the types NSMovie can support.
          </desc>
        </method>
        <method type="NSArray*" factory="yes" ovadd="1.0.0">
          <sel>movieUnfilteredPasteboardTypes</sel>
          <desc>
            An array of all of the pasteboard types NSMovie can
            support.
          </desc>
        </method>
        <method type="void*" ovadd="1.0.0">
          <sel>QTMovie</sel>
          <desc>
            Returns the raw data for the movie.
          </desc>
        </method>
        <method type="NSURL*" ovadd="1.0.0">
          <sel>URL</sel>
          <desc>
            Returns the URL of the movie to be played.
          </desc>
        </method>
        <method type="instancetype" ovadd="1.0.0">
          <sel>initWithMovie:</sel>
          <arg type="void*">movie</arg>
          <desc>
            Returns an NSMovie with the raw data pointed to by
            <var>movie</var>.
          </desc>
        </method>
        <method type="instancetype" ovadd="1.0.0">
          <sel>initWithPasteboard:</sel>
          <arg type="NSPasteboard*">pasteboard</arg>
          <desc>
            Returns an NSMovie initialized with the
            <var>pasteboard</var> passed in.
          </desc>
        </method>
        <method type="instancetype" ovadd="1.0.0">
          <sel>initWithURL:</sel>
          <arg type="NSURL*">url</arg>
          <sel>byReference:</sel>
          <arg type="BOOL">byRef</arg>
          <desc>
            Returns an NSMovie with the given URL.
            <var>byRef</var> should be <code>YES</code> if it is
            by reference.
          </desc>
        </method>
      </class>
    </chapter>
