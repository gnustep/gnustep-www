  <head>
    <title>NSButtonTouchBarItem</title>
    <author name="Gregory John Casamento">
    </author>
    <date>Generated at 2025-11-18 15:37:48 +0100</date>
    <abstract>
      Button control item for Touch Bar interfaces
    </abstract>
