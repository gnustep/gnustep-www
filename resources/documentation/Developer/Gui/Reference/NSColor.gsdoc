      <heading>
        Software documentation for the NSColor class
      </heading>
      <class name="NSColor" super="NSObject" ovadd="1.0.0">
        <declared>AppKit/NSColor.h</declared>
        <conform>NSCoding</conform>
        <conform>NSCopying</conform>
