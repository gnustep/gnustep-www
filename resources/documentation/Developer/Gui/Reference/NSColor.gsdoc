        <method type="void" ovadd="1.0.0">
          <sel>getCyan:</sel>
          <arg type="CGFloat*">cyan</arg>
          <sel>magenta:</sel>
          <arg type="CGFloat*">magenta</arg>
          <sel>yellow:</sel>
          <arg type="CGFloat*">yellow</arg>
          <sel>black:</sel>
          <arg type="CGFloat*">black</arg>
          <sel>alpha:</sel>
          <arg type="CGFloat*">alpha</arg>
          <desc>
            Gets the CMYK components of the color. cyan: Pointer
            to store the <var>cyan</var> component (0.0 to 1.0)
            magenta: Pointer to store the <var>magenta</var>
            component (0.0 to 1.0) yellow: Pointer to store
            the <var>yellow</var> component (0.0 to 1.0) black:
            Pointer to store the <var>black</var> component
            (0.0 to 1.0) alpha: Pointer to store the
            <var>alpha</var> component (0.0 to 1.0) <br />
            <p>
              Gets the <var>cyan</var>, <var>magenta</var>,
              <var>yellow</var>,black and <var>alpha</var> values
              from the NSColor. Raises a
              NSInternalInconsistencyException
              if the NSColor is not a CYMK color
            </p>
          </desc>
        </method>
