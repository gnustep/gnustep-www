        <method type="instancetype" factory="yes" ovadd="0.0.0">
          <sel>imageRepWithData:</sel>
          <arg type="NSData*">imageData</arg>
          <desc>
            Creates a new PDF image representation from PDF
            data. imageData: NSData containing the PDF document
            content Returns: A new autoreleased NSPDFImageRep
            instance, or <code>nil</code> if the data is
            invalid
          </desc>
        </method>
        <method type="NSData*" ovadd="0.0.0">
          <sel>PDFRepresentation</sel>
          <desc>
            Returns the original PDF data used to create this
            image representation. This provides access to the
            complete PDF document for saving or further
            processing. Returns: NSData containing the
            complete PDF document
          </desc>
        </method>
        <method type="NSRect" ovadd="0.0.0">
          <sel>bounds</sel>
          <desc>
            Returns the bounding rectangle of the current page
            in the PDF document. The bounds are in the PDF's
            coordinate system and may need transformation
            for display purposes. Returns: NSRect representing the
            bounds of the current page
          </desc>
        </method>
        <method type="NSInteger" ovadd="0.0.0">
          <sel>currentPage</sel>
          <desc>
            Returns the zero-based index of the currently
            selected page. Returns: The current page index,
            starting from 0
          </desc>
        </method>
        <method type="instancetype" ovadd="0.0.0">
          <sel>initWithData:</sel>
          <arg type="NSData*">imageData</arg>
          <desc>
            Initializes a PDF image representation with PDF
            data. imageData: NSData containing the PDF document
            content Returns: An initialized NSPDFImageRep
            instance, or <code>nil</code> if the data is
            invalid
          </desc>
        </method>
        <method type="NSInteger" ovadd="0.0.0">
          <sel>pageCount</sel>
          <desc>
            Returns the total number of pages in the PDF
            document. Returns: The number of pages available
            in the PDF document
          </desc>
        </method>
        <method type="void" ovadd="0.0.0">
          <sel>setCurrentPage:</sel>
          <arg type="NSInteger">currentPage</arg>
          <desc>
            Sets the currently selected page for display and
            rendering operations. currentPage: Zero-based
            page index to select (must be within page count
            bounds)
          </desc>
        </method>
