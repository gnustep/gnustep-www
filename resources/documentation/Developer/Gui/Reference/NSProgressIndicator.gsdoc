        <method type="void" ovadd="99.99.99" ovrem="10.5.0">
          <sel>animate:</sel>
          <arg type="id">sender</arg>
          <desc>
            Advances the indeterminate animation by one frame.
          </desc>
        </method>
        <method type="NSTimeInterval" ovadd="99.99.99" ovrem="10.5.0">
          <sel>animationDelay</sel>
          <desc>
            Time interval between animation frames in seconds.
          </desc>
        </method>
        <method type="NSControlSize" ovadd="1.0.0">
          <sel>controlSize</sel>
          <desc>
            Standard control layout. <br /> Returns the
            control size used by the indicator.
          </desc>
        </method>
        <method type="NSControlTint" ovadd="1.0.0">
          <sel>controlTint</sel>
          <desc>
            Returns the control tint used by the indicator.
          </desc>
        </method>
        <method type="double" ovadd="1.0.0">
          <sel>doubleValue</sel>
          <desc>
            Current progress value.
          </desc>
        </method>
        <method type="void" ovadd="1.0.0">
          <sel>incrementBy:</sel>
          <arg type="double">delta</arg>
          <desc>
            Advancing the progress bar in determinate mode.
            <br /> Increments the current value by the specified
            <var>delta</var>.
          </desc>
        </method>
        <method type="BOOL" ovadd="1.0.0">
          <sel>isBezeled</sel>
          <desc>
            Setting the appearance. <br /> Indicates whether a
            bezel is drawn.
          </desc>
        </method>
        <method type="BOOL" ovadd="10.2.0">
          <sel>isDisplayedWhenStopped</sel>
          <desc>
            Indicates whether the indicator remains visible
            when stopped.
          </desc>
        </method>
        <method type="BOOL" ovadd="1.0.0">
          <sel>isIndeterminate</sel>
          <desc>
            Indicates whether the indicator is indeterminate.
          </desc>
        </method>
        <method type="double" ovadd="1.0.0">
          <sel>maxValue</sel>
          <desc>
            Maximum progress value.
          </desc>
        </method>
        <method type="double" ovadd="1.0.0">
          <sel>minValue</sel>
          <desc>
            Minimum progress value.
          </desc>
        </method>
        <method type="void" ovadd="99.99.99" ovrem="10.5.0">
          <sel>setAnimationDelay:</sel>
          <arg type="NSTimeInterval">delay</arg>
          <desc>
            Sets the time interval between animation frames in
            seconds.
          </desc>
        </method>
        <method type="void" ovadd="1.0.0">
          <sel>setBezeled:</sel>
          <arg type="BOOL">flag</arg>
          <desc>
            Enables or disables the bezel.
          </desc>
        </method>
        <method type="void" ovadd="1.0.0">
          <sel>setControlSize:</sel>
          <arg type="NSControlSize">size</arg>
          <desc>
            Sets the control <var>size</var> used by the
            indicator.
          </desc>
        </method>
        <method type="void" ovadd="1.0.0">
          <sel>setControlTint:</sel>
          <arg type="NSControlTint">tint</arg>
          <desc>
            Sets the control <var>tint</var> used by the
            indicator.
          </desc>
        </method>
        <method type="void" ovadd="10.2.0">
          <sel>setDisplayedWhenStopped:</sel>
          <arg type="BOOL">flag</arg>
          <desc>
            Shows or hides the indicator when it is stopped.
          </desc>
        </method>
        <method type="void" ovadd="1.0.0">
          <sel>setDoubleValue:</sel>
          <arg type="double">aValue</arg>
          <desc>
            Sets the current progress value.
          </desc>
        </method>
        <method type="void" ovadd="1.0.0">
          <sel>setIndeterminate:</sel>
          <arg type="BOOL">flag</arg>
          <desc>
            Sets whether the indicator is indeterminate.
          </desc>
        </method>
        <method type="void" ovadd="1.0.0">
          <sel>setMaxValue:</sel>
          <arg type="double">newMaximum</arg>
          <desc>
            Sets the maximum progress value.
          </desc>
        </method>
        <method type="void" ovadd="1.0.0">
          <sel>setMinValue:</sel>
          <arg type="double">newMinimum</arg>
          <desc>
            Sets the minimum progress value.
          </desc>
        </method>
        <method type="void" ovadd="10.2.0">
          <sel>setStyle:</sel>
          <arg type="NSProgressIndicatorStyle">style</arg>
          <desc>
            Sets the visual <var>style</var> (bar or spinning).
          </desc>
        </method>
        <method type="void" ovadd="1.0.0">
          <sel>setUsesThreadedAnimation:</sel>
          <arg type="BOOL">flag</arg>
          <desc>
            Enables or disables background-thread animation.
          </desc>
        </method>
        <method type="void" ovadd="10.2.0">
          <sel>sizeToFit</sel>
          <desc>
            Adjusts the receiver’s size to fit the current
            style and control size.
          </desc>
        </method>
        <method type="void" ovadd="1.0.0">
          <sel>startAnimation:</sel>
          <arg type="id">sender</arg>
          <desc>
            Starts indeterminate animation.
          </desc>
        </method>
        <method type="void" ovadd="1.0.0">
          <sel>stopAnimation:</sel>
          <arg type="id">sender</arg>
          <desc>
            Stops indeterminate animation.
          </desc>
        </method>
        <method type="NSProgressIndicatorStyle" ovadd="10.2.0">
          <sel>style</sel>
          <desc>
            Returns the visual style (bar or spinning).
          </desc>
        </method>
        <method type="BOOL" ovadd="1.0.0">
          <sel>usesThreadedAnimation</sel>
          <desc>
            Indicates whether animation runs on a background
            thread.
          </desc>
        </method>
      </class>
