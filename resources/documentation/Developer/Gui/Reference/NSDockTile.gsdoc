        <method type="NSString*" ovadd="10.5.0">
          <sel>badgeLabel</sel>
          <desc>
            Returns the current badge label text displayed on
            the dock tile. Returns: The badge label string, or
            <code>nil</code> if no badge is set
          </desc>
        </method>
        <method type="NSView*" ovadd="10.5.0">
          <sel>contentView</sel>
          <desc>
            Returns the custom content view overlaid on the
            dock tile. Returns: The current content view, or
            <code>nil</code> if none is set
          </desc>
        </method>
        <method type="void" ovadd="10.5.0">
          <sel>display</sel>
          <desc>
            Forces the dock tile to redraw with current content
            and settings. This method should be called after making
            changes to ensure the dock tile reflects the
            updated state.
          </desc>
        </method>
        <method type="id" ovadd="10.5.0">
          <sel>owner</sel>
          <desc>
            Returns the owner object associated with this dock
            tile. Returns: The owner object, typically the
            application instance
          </desc>
        </method>
        <method type="void" ovadd="10.5.0">
          <sel>setBadgeLabel:</sel>
          <arg type="NSString*">label</arg>
          <desc>
            Sets the badge <var>label</var> text to display on the
            dock tile. label: The text to display as a badge, or
            <code>nil</code> to remove the badge
          </desc>
        </method>
        <method type="void" ovadd="10.5.0">
          <sel>setContentView:</sel>
          <arg type="NSView*">contentView</arg>
          <desc>
            Sets a custom content view to overlay on the dock
            tile. contentView: The view to display on the dock
            tile, or <code>nil</code> to remove
          </desc>
        </method>
        <method type="void" ovadd="10.5.0">
          <sel>setOwner:</sel>
          <arg type="id">owner</arg>
          <desc>
            Sets the <var>owner</var> object associated with this
            dock tile. owner: The object that owns this dock tile
            instance
          </desc>
        </method>
        <method type="void" ovadd="10.5.0">
          <sel>setShowsApplicationBadge:</sel>
          <arg type="BOOL">flag</arg>
          <desc>
            Sets whether the application badge should be visible
            on the dock tile. flag: <code>YES</code> to show the
            application badge, <code>NO</code> to hide it
          </desc>
        </method>
        <method type="BOOL" ovadd="10.5.0">
          <sel>showsApplicationBadge</sel>
          <desc>
            Returns whether the application badge is currently
            visible. Returns: <code>YES</code> if the
            application badge is shown, <code>NO</code>
            otherwise
          </desc>
        </method>
        <method type="NSSize" ovadd="10.5.0">
          <sel>size</sel>
          <desc>
            Returns the size of the dock tile for content
            layout purposes. Returns: The size of the dock tile
            in points
          </desc>
        </method>
