          <sel>outputUnit:</sel>
          <arg type="GSXMLNode*">node</arg>
          <sel>to:</sel>
          <arg type="NSMutableString*">buf</arg>
          <desc>
            <em>Description forthcoming.</em>
          </desc>
        </method>
